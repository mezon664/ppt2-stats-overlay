# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Large local data: recordings, debug captures, logs
samples/
debug_frames/
logs/
server_log.txt

# Each user's own settings (defaults live in scripts/config_store.py and the
# file is created on first run)
config/overlay_settings.json
config/opener_history.json
config/rating_history.json
config/*.tmp
# Fonts a user loaded from the settings window (copies of their own files)
assets/user_fonts/
# Pictures a user picked for 縛りプレイ (challenge_image, copies of their own files)
assets/user_images/

# Release zips (tools/make_release.py)
dist/

# tools/build_full.py work folder
build/

# Opener import inputs (tools/opener_import/build_openers.py): collected from
# the wikis, kept local — wiki_heads.json holds page text. The result,
# assets/openers.json, is what the app uses.
tools/opener_import/wiki_tags.json
tools/opener_import/wiki_heads.json
tools/opener_import/harddrop.json

# tools/make_release.py: the libraries shipped in the zip as vendor/
vendor/

# Claude Code settings for this PC only
.claude/settings.local.json
